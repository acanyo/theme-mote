{
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nodemon --config nodemon.json --exec 'astro build'",
    "build:templates": "astro build",
    "build": "astro build && node scripts/package-theme.mjs",
    "check": "astro check",
    "pack": "pnpm run check && pnpm run build",
    "format": "prettier --write ."
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "dependencies": {
    "@swup/head-plugin": "^2.3.1",
    "@swup/preload-plugin": "^3.2.12",
    "@swup/scroll-plugin": "^4.0.0",
    "astro": "^6.1.4",
    "gsap": "^3.15.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "swup": "^4.10.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/qrcode": "^1.5.6",
    "nodemon": "^3.1.14",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^5.9.3"
  }
}
