---
import Layout from "../layouts/Layout.astro";
import Intro from "../components/home/Intro.astro";
import Writing from "../components/home/Writing.astro";
import MomentsFeed from "../components/home/MomentsFeed.astro";
import GalleryStrip from "../components/home/GalleryStrip.astro";
import Projects from "../components/home/Projects.astro";
import Friends from "../components/home/Friends.astro";
import HomeClosing from "../components/home/HomeClosing.astro";
import SeoHead from "../components/common/SeoHead.astro";
import "../styles/home.css";
---

<Layout page="home">
  <SeoHead
    slot="head"
    type="website"
    titleExpr="site.title"
    descExpr="site.subtitle ?: ''"
    pathExpr="'/'"
    jsonLdKind="WebSite"
  />
  <div class="home wrap" data-home>
    <th:block th:if="${posts.page == 1}">
      <Intro />
    </th:block>

    <Writing />

    <th:block th:if="${posts.page == 1}">
      <MomentsFeed />
      <GalleryStrip />
      <Projects />
      <Friends />
      <HomeClosing />
    </th:block>
  </div>
</Layout>
