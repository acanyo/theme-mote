---
import Layout from "../../layouts/Layout.astro";
import "../../styles/error.css";
---

<Layout page="error" titlePrefixExpr="'页面不存在'">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <section class="error-page wrap">
    <p class="error-code num">404</p>
    <h1 class="error-title">这个页面不存在</h1>
    <p class="error-text">链接可能已失效，或者文章已被移走。</p>
    <div class="error-actions">
      <a class="ink-button is-primary" href="/">返回首页</a>
      <button type="button" class="ink-button" data-random-trigger>
        随机读一篇
      </button>
    </div>
  </section>
</Layout>
