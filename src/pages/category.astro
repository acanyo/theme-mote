---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/common/PageHead.astro";
import PostList from "../components/post/PostList.astro";
import SeoHead from "../components/common/SeoHead.astro";
import "../styles/taxonomy.css";
---

<Layout page="category" title="|${category.spec.displayName} - ${site.title}|">
  <SeoHead
    slot="head"
    type="website"
    titleExpr="(category.spec.displayName ?: '分类') + ' - ' + (site.title ?: 'Mote')"
    descExpr="category.spec.description ?: ''"
    imageExpr="category.spec.cover ?: ''"
    pathExpr="category.status?.permalink ?: ''"
    crumbParentNameExpr="category.spec.displayName ?: '分类'"
    crumbParentPathExpr="category.status?.permalink ?: ''"
    jsonLdKind="CollectionPage"
  />
  <div class="taxonomy-detail-top wrap">
    <a class="taxonomy-back" href="/categories" th:href="@{/categories}">
      <span class="back-arrow" aria-hidden="true">←</span>
      <span>全部分类</span>
    </a>
  </div>

  <PageHead title="${category.spec.displayName}" fallback="分类">
    <p
      th:if="${not #strings.isEmpty(category.spec.description)}"
      th:text="${category.spec.description}"
    >
    </p>
    <p class="num" th:text="|共 ${posts.total} 篇文章|">共 0 篇文章</p>
  </PageHead>

  <th:block
    th:with="allCats = ${categoryFinder.listAll()}, activeCats = ${allCats != null ? allCats.?[postCount != null and postCount > 0] : null}"
  >
    <nav
      class="taxonomy-switcher wrap"
      aria-label="切换分类"
      th:if="${activeCats != null and #lists.size(activeCats) > 1}"
    >
      <a
        class="taxonomy-switch-tab"
        th:each="item : ${activeCats}"
        th:href="@{${item.status.permalink}}"
        th:classappend="${item.metadata.name == category.metadata.name} ? 'is-active'"
      >
        <span th:text="${item.spec.displayName}">分类</span>
        <span class="num" th:text="${item.postCount}">0</span>
      </a>
    </nav>
  </th:block>

  <PostList empty="这个分类下还没有文章。" />
</Layout>
