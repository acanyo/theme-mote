---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/common/PageHead.astro";
import PostList from "../components/post/PostList.astro";
import SeoHead from "../components/common/SeoHead.astro";
import "../styles/taxonomy.css";
---

<Layout page="tag" title="|${tag.spec.displayName} - ${site.title}|">
  <SeoHead
    slot="head"
    type="website"
    titleExpr="'#' + (tag.spec.displayName ?: '标签') + ' - ' + (site.title ?: 'Mote')"
    descExpr="site.subtitle ?: ''"
    imageExpr="tag.spec.cover ?: ''"
    pathExpr="tag.status?.permalink ?: ''"
    crumbParentNameExpr="'#' + (tag.spec.displayName ?: '标签')"
    crumbParentPathExpr="tag.status?.permalink ?: ''"
    jsonLdKind="CollectionPage"
  />
  <div class="taxonomy-detail-top wrap">
    <a class="taxonomy-back" href="/tags" th:href="@{/tags}">
      <span class="back-arrow" aria-hidden="true">←</span>
      <span>全部标签</span>
    </a>
  </div>

  <PageHead title="|# ${tag.spec.displayName}|" fallback="标签">
    <p class="num" th:text="|共 ${posts.total} 篇文章|">共 0 篇文章</p>
  </PageHead>

  <th:block
    th:with="allTags = ${tagFinder.listAll()}, activeTags = ${allTags != null ? allTags.?[postCount != null and postCount > 0] : null}"
  >
    <nav
      class="taxonomy-switcher wrap"
      aria-label="切换标签"
      th:if="${activeTags != null and #lists.size(activeTags) > 1}"
    >
      <th:block th:each="item, iter : ${activeTags}">
        <a
          class="taxonomy-switch-tab"
          th:if="${iter.index < 10}"
          th:href="@{${item.status.permalink}}"
          th:classappend="${item.metadata.name == tag.metadata.name} ? 'is-active'"
        >
          <span th:text="|#${item.spec.displayName}|">#标签</span>
          <span class="num" th:text="${item.postCount}">0</span>
        </a>
      </th:block>
    </nav>
  </th:block>

  <PostList empty="这个标签下还没有文章。" />
</Layout>
