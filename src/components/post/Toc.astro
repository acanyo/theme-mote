---
/** Outline filled by scripts/toc.ts; stays hidden for short articles. */
---

<nav class="toc" aria-label="文章目录" data-toc hidden>
  <div class="toc-head">
    <p class="toc-title">目录</p>
    <span class="toc-pct num" data-toc-pct>0%</span>
  </div>
  <div class="toc-body">
    <div class="toc-track">
      <span class="toc-indicator" data-toc-indicator aria-hidden="true"></span>
      <ol class="toc-list" data-toc-list></ol>
    </div>
  </div>
</nav>
